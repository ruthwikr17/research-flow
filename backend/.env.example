# Groq console: https://console.groq.com/keys
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL_PLANNER=openai/gpt-oss-20b
GROQ_MODEL_VERIFIER=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Google AI Studio / Google Cloud: one Gemini key per separate GCP project, comma-separated
GEMINI_PROJECT_KEYS=replace-with-gemini-project-key-1,replace-with-gemini-project-key-2
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Tavily dashboard: https://app.tavily.com/home
TAVILY_API_KEY=replace-with-tavily-key
# Exa dashboard: https://dashboard.exa.ai/api-keys
EXA_API_KEY=replace-with-exa-key
TAVILY_MONTHLY_CREDIT_LIMIT=1000
EXA_MONTHLY_CREDIT_BUDGET=1400
MAX_CONCURRENT_RESEARCHERS=4
# Number of distinct search() calls per researcher (widening attempts)
MAX_SEARCH_ATTEMPTS_PER_RESEARCHER=3
# Results fetched per individual search() call
MAX_RESULTS_PER_SEARCH_CALL=5
PIPELINE_TIMEOUT_SECONDS=120
# Daily query cap — tune using real per-query cost data before public exposure
MAX_QUERIES_PER_DAY=30
# Comma-separated browser origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000
